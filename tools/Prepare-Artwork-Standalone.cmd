@echo off
setlocal
set "RETROVERSE_ART_SELF=%~f0"
set "RETROVERSE_ART_TARGET=%~1"
powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -Command "try { $text=[IO.File]::ReadAllText($env:RETROVERSE_ART_SELF); $encoded=($text -split ':RETROVERSE_PAYLOAD\r?\n',2)[1].Trim(); $m=New-Object IO.MemoryStream(,[Convert]::FromBase64String($encoded)); $g=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress); $reader=New-Object IO.StreamReader($g,[Text.Encoding]::UTF8); $code=$reader.ReadToEnd(); $reader.Dispose(); & ([scriptblock]::Create($code)) -RetroVerseFolder $env:RETROVERSE_ART_TARGET -Offline:($env:RETROVERSE_ART_OFFLINE -eq '1') } catch { Write-Host ('Artwork preparation stopped: '+$_.Exception.Message) -ForegroundColor Red; exit 1 }"
pause
exit /b
:RETROVERSE_PAYLOAD

